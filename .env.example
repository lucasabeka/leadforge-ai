# ── Server ────────────────────────────────────────────────
PORT=8080

# ── Database (PostgreSQL) ─────────────────────────────────
# When running via docker-compose these are set automatically.
# Set these only if you run the backend directly without Docker.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadforge_db
DB_USER=user
DB_PASSWORD=password

# ── Anthropic / Claude AI ─────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Google OAuth ──────────────────────────────────────────
# 1. https://console.cloud.google.com/ > APIs & Services > Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Authorized redirect URI: http://localhost:8080/api/auth/google/callback
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# ── JWT ───────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=change-me-to-a-long-random-secret

# ── Stripe ────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys (use "test" keys for local dev)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── URLs ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200
